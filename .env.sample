# Copy to .env and fill in. .env is the single source of truth for both local
# runs and the Kubernetes deployment (see scripts/gen-k8s-config.sh).
# Never commit .env.

# --- WorldCat Search API v2 (OCLC WSKey, client-credentials grant) -----------
# Secret: goes into the k8s Secret
WC_API_CLIENT_KEY=your-wskey-client-id
# Secret: goes into the k8s Secret
WC_API_SECRET=your-wskey-secret

# Base URL where the WorldCat Search API is hosted
API_BASE_URL=https://americas.discovery.api.oclc.org

# Optional: OAuth token endpoint and scope (defaults shown)
# WC_TOKEN_URL=https://oauth.oclc.org/token
# WC_API_SCOPE=wcapi

# --- Deployment --------------------------------------------------------------
# Hostname at which this MCP server will be reachable (https, via Ingress)
MCP_URL=worldcat-mcp.example.endeavour.cs.vt.edu

# Container registry from which Kubernetes pulls the image, plus a
# read-only deploy token (goes into an imagePullSecret)
REGISTRY_SERVER=container.cs.vt.edu
REGISTRY_USERNAME=gitlab+deploy-token-NN
REGISTRY_PASSWORD=gldt-xxxxxxxxxxxxxxxx

# Full image reference to build, push, and deploy
MCP_IMAGE=container.cs.vt.edu/youruser/registry/worldcat-mcpserver:latest

# Optional: log level for the server (DEBUG, INFO, WARNING, ...)
# LOG_LEVEL=INFO
